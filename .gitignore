Qt/
aqtinstall.log

# ── PyForge user data (stored outside repo under ~/.pyforge) ─────────────────
# These paths live in the user's home dir, not the repo, but guard against
# anyone accidentally running the app from inside ~/.pyforge.
outputs/
*.pyforge_history

